    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# NumPy Operations\n",
    "arr = np.array([10, 20, 30, 40, 50])\n",
    "print('Array:', arr)\n",
    "print('Mean:', arr.mean())\n",
    "print('Reshaped 2D:\\n', arr.reshape(5, 1))\n",
    "print('Sliced (index 1 to 3):', arr[1:4])\n",
    "\n",
    "# Creating the DataFrame data from the table below\n",
    "data = {\n",
    "    'Name': ['Asha', 'Ravi', 'Meera', 'Kiran'],\n",
    "    'Marks': [80, 65, 90, 75],\n",
    "    'Branch': ['CSE', 'ECE', 'CSE', 'ISE']\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Left margin note: print(df)\n",
    "print(df)\n",
    "\n",
    "# Pandas Operations\n",
    "print('\\nFirst 2 rows:\\n', df.iloc[0:2])\n",
    "print('\\nMarks column:\\n', df['Marks'])\n",
    "print('\\nRows where Marks > 70:\\n', df[df['Marks'] > 70])"
   ]
